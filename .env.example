# ============ 基础 ============
APP_NAME=Personal KB Agent
ENV=dev
DEBUG=false
LOG_LEVEL=INFO

# ============ 安全 ============
# 生产必须替换：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-32-bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============ 数据库 ============
# 本地默认 SQLite；docker compose 下由 compose 覆盖为 PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# DATABASE_URL=postgresql+asyncpg://kb:kb_password@localhost:5432/kb
DB_ECHO=false
AUTO_CREATE_TABLES=true

# ============ Redis（留空则自动降级为进程内存） ============
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0
CACHE_REQUIRED=false

# ============ 向量库 ============
# auto: 优先 Chroma，装不上自动退内存；chroma / memory 可强制指定
VECTOR_BACKEND=auto
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=kb_documents
# hashing: 零依赖确定性；sentence-transformers: 需额外装包与模型
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=384

# ============ 检索 ============
RAG_TOP_K=8
RAG_RERANK_TOP_N=3
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
RERANKER=lexical

# ============ LLM ============
# fake: 离线确定性模型，无需 API Key 即可跑通全链路与测试
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ============ 成本核算（USD / 1K tokens） ============
PRICE_PROMPT_PER_1K=0.00015
PRICE_COMPLETION_PER_1K=0.0006

# ============ 上下文与韧性 ============
HISTORY_MAX_TURNS=6
TOOL_TIMEOUT_SECONDS=10
TOOL_MAX_RETRIES=2
TOOL_BACKOFF_SECONDS=0.3

# ============ 限流与保护 ============
RATE_LIMIT_PER_MINUTE=30
SQL_MAX_ROWS=200

# ============ CORS ============
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
