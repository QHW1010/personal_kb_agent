# ============ 基础 ============
APP_NAME=Personal KB Agent
ENV=dev
DEBUG=false
LOG_LEVEL=INFO

# ============ 安全 ============
# 生产必须替换：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-32-bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============ 数据库 ============
# 本地默认 SQLite；docker compose 下由 compose 覆盖为 PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# DATABASE_URL=postgresql+asyncpg://kb:kb_password@localhost:5432/kb
DB_ECHO=false
AUTO_CREATE_TABLES=true

# ============ Redis（留空则自动降级为进程内存） ============
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0
CACHE_REQUIRED=false

# ============ 向量库 ============
# auto: 优先 Chroma，装不上自动退内存；chroma / memory 可强制指定
VECTOR_BACKEND=auto
CHROMA_DIR=./data/chroma
# 基础集合名。fastembed 会派生出带 provider+model+dim 后缀的独立集合
# （如 kb_documents_fastembed_baai_bge_small_zh_v1_5_512），旧 hashing 索引不受影响
CHROMA_COLLECTION=kb_documents

# ============ Embedding ============
# hashing: 零依赖确定性向量（CI / 离线兜底，非语义）
# fastembed: ONNX 真实语义模型，复用 onnxruntime，不需要 torch（推荐）
# sentence-transformers: 保留兼容，需要 torch，默认不装
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 仅 hashing 生效；fastembed 以模型实际维度为准（bge-small-zh-v1.5 = 512）
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32
# e5 系列必须加前缀（query: / passage:）；bge-zh-v1.5 官方说明无需前缀，留空
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=
# 缺包 / 模型不可用时降级为 hashing，而不是让整个服务起不来
EMBEDDING_FALLBACK_TO_HASHING=true

# ============ 模型下载（国内镜像） ============
# huggingface.co 在部分网络不可达，默认走镜像；代码里也会 setdefault，双保险
HF_ENDPOINT=https://hf-mirror.com
# 镜像站不支持 XET CAS，不关会先失败再回退
HF_HUB_DISABLE_XET=1
FASTEMBED_CACHE_DIR=./data/models

# ============ 检索 ============
RAG_TOP_K=8
RAG_RERANK_TOP_N=3
# bge-small-zh 上下文 512 token，中文约 1 字 1 token，块长必须留余量
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=60
RERANKER=lexical
# RAG 独立超时：首次加载模型要下载 90MB，不能套用全局 10s
RAG_RETRIEVE_TIMEOUT_SECONDS=15
RAG_EMBED_TIMEOUT_SECONDS=20
RAG_MODEL_LOAD_TIMEOUT_SECONDS=600
# 首次启动灌入 4 篇演示语料（零配置也能问出东西）；只想看到自己 docs/ 的内容就设 false
SEED_DEMO_DOCS=true

# ============ LLM ============
# fake: 离线确定性模型，无需 API Key 即可跑通全链路与测试
# openai: OpenAI-compatible gateway (DeepSeek / vLLM / Azure)
LLM_PROVIDER=fake
MODEL_NAME=deepseek-chat        # LLM_MODEL also accepted
OPENAI_API_KEY=                 # LLM_API_KEY also accepted; never commit a real key
OPENAI_BASE_URL=                # e.g. https://api.deepseek.com/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=90          # answer generation; TOOL_TIMEOUT_SECONDS(10s) is too short
LLM_INTENT_TIMEOUT_SECONDS=20   # intent classification; times out -> rule fallback
LLM_WARMUP=true                 # warm up connection at startup (~7s boot, faster first answer)

# ============ 成本核算（USD / 1K tokens） ============
PRICE_PROMPT_PER_1K=0.00015
PRICE_COMPLETION_PER_1K=0.0006

# ============ 上下文与韧性 ============
HISTORY_MAX_TURNS=6
TOOL_TIMEOUT_SECONDS=10
TOOL_MAX_RETRIES=2
TOOL_BACKOFF_SECONDS=0.3

# ============ 限流与保护 ============
RATE_LIMIT_PER_MINUTE=30
SQL_MAX_ROWS=200

# ============ CORS ============
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
